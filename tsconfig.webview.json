{
    "compilerOptions": {
        "target": "ES2020",
        "jsx": "react-jsx",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src/webview/**/*"
    ]
}