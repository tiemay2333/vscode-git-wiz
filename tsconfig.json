{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020"],
        "rootDir": "src",
        "module": "commonjs",
        "types": ["node", "vscode"],
        "strict": true,
        "outDir": "out",
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "exclude": ["node_modules", ".vscode-test", "src/webview", "vitest.config.ts", "eslint.config.ts"]
}
