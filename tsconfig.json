{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "rootDir": "src",
        "module": "commonjs",
        "jsx": "react-jsx",
        "types": ["node", "vscode"],
        "strict": true,
        "outDir": "out",
        "sourceMap": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "exclude": ["node_modules", ".vscode-test", "vitest.config.ts", "eslint.config.ts"]
}
